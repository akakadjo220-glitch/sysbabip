// Déploiement Cloudflare du site babipass.com (Worker + fichiers statiques).
// « name » doit être EXACTEMENT le nom du Worker existant dans le tableau de bord
// Cloudflare, sinon un second Worker serait créé à côté.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "remplacer-par-le-nom-du-worker",
  "main": "worker/index.js",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Toute adresse inconnue renvoie index.html (l'application gère la page).
    "not_found_handling": "single-page-application",
    // Seules ces adresses passent par le Worker (aperçus de partage, sitemap) ;
    // tout le reste est servi directement par Cloudflare, sans surcoût.
    "run_worker_first": ["/event/*", "/collecte/*", "/tournoi/*", "/sitemap.xml"]
  },
  "vars": {
    "API_URL": "https://api.babipass.com",
    "SUPABASE_URL": "https://supabasekong-pb8ykq5lxueompxiu9p5ust2.51.255.162.88.sslip.io",
    // Clé publique « anon » (déjà présente dans le code du site) : lecture de ce
    // que tout visiteur peut voir, rien de plus (RLS).
    "SUPABASE_ANON_KEY": "eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJpc3MiOiJzdXBhYmFzZSIsImlhdCI6MTc4MzUxNDgyMCwiZXhwIjo0OTM5MTg4NDIwLCJyb2xlIjoiYW5vbiJ9.Jckb-tWy6_BmNXv1VJswhBxcxdIlpFiD5rl4GZKC_Ec"
  },
  "observability": { "enabled": true }
}
